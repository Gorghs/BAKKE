# ---- Core ----
DATABASE_URL=postgresql+psycopg2://bakke:bakke@localhost:5432/bakke
REDIS_URL=redis://localhost:6379/0

# Use SQLite for tests / local fallback (set manually if needed)
# DATABASE_URL=sqlite:///./data/bakke.db

# ---- App ----
APP_ENV=development
SECRET_KEY=change-me-in-production
# Comma-separated origins. Empty = "*" in development; required, non-wildcard in production.
CORS_ALLOW_ORIGINS=
DATA_DIR=./data
MAX_REASONING_ITERATIONS=5
MAX_HYPOTHESES=60
TOP_N_DEFAULT=10
UPLOAD_MAX_MB=25
VIDEO_OUTPUT_DIR=./data/videos

# ---- Auth (optional) ----
# Firebase is optional. If unset, BAKKE runs in development mode with a
# built-in developer user clearly labelled DEV.
# All three are required in production.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_CREDENTIAL_PATH=

# ---- Storage ----
# local | firebase
STORAGE_PROVIDER=local
FIREBASE_STORAGE_BUCKET=

# ---- Providers ----
# Per capability: <PREFIX>_PROVIDER_TYPE | <PREFIX>_API_BASE_URL | <PREFIX>_API_KEY | <PREFIX>_MODEL
# PROVIDER_TYPE: mock | http_chat | <adapter id> (video_generation: mock | kling | runway | hailuo)
# http_chat requires API_BASE_URL, API_KEY and MODEL.
# Precedence: runtime DB override -> generic env -> legacy env -> mock.

# Text / LLM
LLM_PROVIDER_TYPE=mock
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Embeddings
EMBEDDING_PROVIDER_TYPE=mock
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Speech to text
STT_PROVIDER_TYPE=mock
STT_API_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# Vision (image analysis)
VISION_PROVIDER_TYPE=mock
VISION_API_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# Video understanding
VIDEO_UNDERSTANDING_PROVIDER_TYPE=mock
VIDEO_UNDERSTANDING_API_BASE_URL=
VIDEO_UNDERSTANDING_API_KEY=
VIDEO_UNDERSTANDING_MODEL=

# Video generation
VIDEO_GENERATION_PROVIDER_TYPE=mock
VIDEO_GENERATION_API_BASE_URL=
VIDEO_GENERATION_API_KEY=
VIDEO_GENERATION_MODEL=

# ---- Legacy (deprecated) — still supported ----
# Fallbacks for the generic keys above; ignored when the generic key is set.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=mock
STT_PROVIDER=mock
VISION_PROVIDER=mock
VIDEO_UNDERSTANDING_PROVIDER=mock
VIDEO_GENERATION_PROVIDER=mock

# ---- Worker ----
JOB_POLL_INTERVAL_SECONDS=1
