# ---- Core ----
DATABASE_URL=postgresql+psycopg2://bakke:bakke@localhost:5432/bakke
REDIS_URL=redis://localhost:6379/0

# Use SQLite for tests / local fallback (set manually if needed)
# DATABASE_URL=sqlite:///./data/bakke.db

# ---- App ----
APP_ENV=development
SECRET_KEY=change-me-in-production
MAX_REASONING_ITERATIONS=5
MAX_HYPOTHESES=60
TOP_N_DEFAULT=10
UPLOAD_MAX_MB=25
VIDEO_OUTPUT_DIR=./data/videos

# ---- Auth (optional) ----
# Firebase is optional. If unset, BAKKE runs in development mode with a
# built-in developer user clearly labelled DEV.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_CREDENTIAL_PATH=

# ---- Storage ----
# local | firebase
STORAGE_PROVIDER=local
FIREBASE_STORAGE_BUCKET=

# ---- LLM ----
# openai | mock
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint (Groq, DeepSeek, OpenRouter, Gemini).
# Leave empty for the official OpenAI API.
OPENAI_BASE_URL=

# ---- Embeddings ----
# openai | mock
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small

# ---- Speech to text ----
# openai | mock
STT_PROVIDER=mock

# ---- Vision (image analysis) ----
# openai | mock
VISION_PROVIDER=mock

# ---- Video understanding ----
# openai | mock
VIDEO_UNDERSTANDING_PROVIDER=mock

# ---- Video generation ----
# mock | fal | kling | runway | hailuo
VIDEO_GENERATION_PROVIDER=mock
VIDEO_GENERATION_API_KEY=
# For fal: a model id, e.g. fal-ai/kling-video/v2.1/standard/text-to-video
VIDEO_GENERATION_MODEL=
# Optional LLM rewrite of the visual prompt. Off keeps the director prompt,
# which names only what the scenario states. On adds cinematic prose but can
# describe fixtures and materials the scenario never states.
VIDEO_PROMPT_EXPANSION=false
# Optional LLM-filled visual brief: setting, actors, props with their start and
# end state, ordered beats, continuity. Every label, action word and clock must
# already appear in the scenario text, or the brief is rejected and the
# deterministic extractor is used instead.
VIDEO_VISUAL_BRIEF=true

# ---- Worker ----
JOB_POLL_INTERVAL_SECONDS=1
